<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>White T-Shirt - Outfitters</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <nav class="navbar navbar-expand-lg bg-white">
    <div class="container">
      <a class="navbar-brand fw-bold" href="index.html">OUTFITTERS</a>
      <a href="#" class="btn btn-dark">Cart (0)</a>
    </div>
  </nav>
  <div class="container my-5">
    <div class="row align-items-center">

      <div class="col-12 col-md-6 mb-4">
        <img
          src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=800"
          class="img-fluid" alt="White T-Shirt">
      </div>

      <div class="col-12 col-md-6">
        <h1>White T-Shirt</h1>
        <h4>Rs. 1,999</h4>

        <p>
          A comfortable white T-shirt for everyday wear.
          It can be paired with jeans and sneakers.
        </p>

        <label for="quantity">Quantity:</label>
        <input type="number" id="quantity" value="1" min="1" max="10"
               class="form-control mb-3" style="width: 100px;">

        <button type="button" class="btn btn-dark">Add to Cart</button>
      </div>

    </div>
  </div>
  <footer class="text-center">
    <h5>OUTFITTERS</h5>
    <p>Everyday fashion for everyone.</p>
    <p>Copyright 2026 - Student Assignment</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

styles.css:

body {
  font-family: Arial, sans-serif;
  background-color: white;
  color: #222;
}
.navbar-brand {
  font-size: 25px;
  letter-spacing: 2px;
}

.banner {
  background-color: #e9e5df;
  padding: 70px 15px;
}

.banner h1 {
  font-size: 36px;
  font-weight: bold;
}

.banner p {
  margin: 15px 0;
}

.card {
  height: 100%;
  border: 1px solid #eee;
}

.card img {
  width: 100%;
  height: 230px;
  object-fit: cover;
}

.card h5 {
  font-size: 16px;
  font-weight: bold;
}

.card p {
  font-weight: bold;
}

.product-name {
  color: #222;
  text-decoration: none;
}

.product-name:hover {
  color: #777;
}

.card .btn {
  width: 100%;
  border-radius: 0;
}
.navbar .btn {
  border-radius: 0;
}
footer {
  background-color: #222;
  color: white;
  padding: 30px 10px;
  margin-top: 30px;
}

@media (max-width: 576px) {
  .banner {
    padding: 45px 10px;
  }

  .banner h1 {
    font-size: 25px;
  }

  .card img {
    height: 160px;
  }

  .card h5 {
    font-size: 14px;
  }

  .card .btn {
    font-size: 12px;
  }
}
